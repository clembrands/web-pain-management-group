{
  "name": "web-pain-management-group",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "seed:sanity": "node --env-file-if-exists=.env.local scripts/seed-sanity.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "verify:urls": "node scripts/verify-urls.mjs",
    "inventory:crawl": "NODE_USE_ENV_PROXY=1 node scripts/inventory/crawl.mjs",
    "inventory:report": "node scripts/inventory/report.mjs"
  },
  "overrides": {
    "@sanity/runtime-cli": {
      "adm-zip": "0.6.0"
    },
    "@vercel/frameworks": {
      "js-yaml": "3.15.1"
    },
    "typeid-js": {
      "uuid": "11.1.1"
    }
  },
  "dependencies": {
    "@next/third-parties": "16.3.4",
    "@portabletext/react": "8.0.1",
    "@sanity/image-url": "2.1.1",
    "@sanity/vision": "5.31.2",
    "next": "16.3.4",
    "next-sanity": "13.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "5.31.2",
    "server-only": "0.0.1",
    "styled-components": "6.5.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
