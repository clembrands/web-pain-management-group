NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-01
# Must be a PRIVATE dataset, separate from public site content.
NEXT_PUBLIC_SANITY_SUBMISSIONS_DATASET=submissions
# Server-only Editor token, used by inquiry forms and the seed script.
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=
# Set only on the final production domain after content approval.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_INDEXABLE=false
# Review uses local placeholder content and always disables indexing.
NEXT_PUBLIC_CONTENT_MODE=review
