NEXT_PUBLIC_SANITY_PROJECT_ID=ac5zxyz7
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-01
# Must be a PRIVATE dataset, separate from public site content.
NEXT_PUBLIC_SANITY_SUBMISSIONS_DATASET=submissions
# Server-only Sanity token with Editor permissions. Used by the inquiry form (writes to the
# private submissions dataset) and by `npm run import:content`. Never expose it to the browser.
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=
# Set only on the final production domain after content approval.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_INDEXABLE=false
# PMG's existing container. It loads only when indexing is on, so preview traffic never
# reaches PMG's analytics. Set NEXT_PUBLIC_ANALYTICS_DEBUG=true to test tags elsewhere.
NEXT_PUBLIC_GTM_ID=GTM-KNQXQ7K
NEXT_PUBLIC_ANALYTICS_DEBUG=false
# Hospital Inquiry Form email notifications (Resend). Leave empty to save to Sanity only.
RESEND_API_KEY=
# Recipient(s) for new inquiries; separate several with commas.
INQUIRY_NOTIFY_TO=
# Sender on a domain verified in Resend, e.g. "PMG Website <website@painmgmtgroup.com>".
INQUIRY_NOTIFY_FROM=
